z_tilde = s_k * z  # sign calibration: s_k ∈ {+1, -1}

## Within-Pillar Weights (Phase A5)
w_jk = |W_tilde_jk| / sum(|W_tilde_lk| for l in J_k)
P_nk = sum(w_jk * x_sc_nj for j in J_k)
S_nk = (P_nk - mean(P_k)) / std(P_k)
alpha_k = rho_k / sum(rho_1, rho_2, rho_3, rho_4)
I_n  = sum(alpha_k * S_nk for k in 1..4)
I_star_n = SCORE_MIN + (SCORE_MAX - SCORE_MIN) * (I_n - I_min) / (I_max - I_min)
