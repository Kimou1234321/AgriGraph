def compute_pillars(raw_features_df):
    x_sc = standard_scaler.transform(raw_features_df)    # standardize for PCA/pillar scoring
    for k in range(4):
        P_k = sum(pillar_meta['w'][j,k] * x_sc[:,j]
                  for j in pillar_meta['J_k'][k])
        S_k = (P_k - score_params['P_bar'][k]) / score_params['sigma_P'][k]
    return S  # shape (N, 4) — ready for STGNN node features

